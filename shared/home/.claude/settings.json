{
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(* --help)",
      "Bash(* --version)",
      "Bash(bun add *)",
      "Bash(bun build *)",
      "Bash(bun info *)",
      "Bash(bun install)",
      "Bash(bun install *)",
      "Bash(bun outdated)",
      "Bash(bun outdated *)",
      "Bash(bun pm bin)",
      "Bash(bun pm bin *)",
      "Bash(bun pm cache)",
      "Bash(bun pm hash)",
      "Bash(bun pm hash *)",
      "Bash(bun pm ls)",
      "Bash(bun pm ls *)",
      "Bash(bun pm why *)",
      "Bash(bun remove *)",
      "Bash(bun run *)",
      "Bash(bun test)",
      "Bash(bun test *)",
      "Bash(bun x *)",
      "Bash(bunx *)",
      "Bash(gh browse *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr list *)",
      "Bash(gh pr status)",
      "Bash(gh pr view *)",
      "Bash(gh repo view *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh search *)",
      "Bash(gh status)",
      "Bash(grep *)",
      "WebFetch",
      "WebSearch"
    ],
    "defaultMode": "auto"
  },
  "model": "claude-fable-5[1m]",
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "dobby@dobby": true,
    "neon@claude-plugins-official": true,
    "vercel@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "ponytail@ponytail": true,
    "linear@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "dobby": {
      "source": {
        "source": "directory",
        "path": "/Users/kvnwolf/Developer/github.com/kvnwolf/dobby"
      },
      "autoUpdate": true
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "language": "Español",
  "effortLevel": "high",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "editorMode": "normal",
  "verbose": false,
  "preferredNotifChannel": "auto",
  "teammateMode": "auto",
  "remoteControlAtStartup": false,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true
}
