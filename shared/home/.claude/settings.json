{
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(* --help)",
      "Bash(* --version)",
      "Bash(bun add *)",
      "Bash(bun build *)",
      "Bash(bun info *)",
      "Bash(bun install)",
      "Bash(bun install *)",
      "Bash(bun outdated)",
      "Bash(bun outdated *)",
      "Bash(bun pm bin)",
      "Bash(bun pm bin *)",
      "Bash(bun pm cache)",
      "Bash(bun pm hash)",
      "Bash(bun pm hash *)",
      "Bash(bun pm ls)",
      "Bash(bun pm ls *)",
      "Bash(bun pm why *)",
      "Bash(bun remove *)",
      "Bash(bun run *)",
      "Bash(bun test)",
      "Bash(bun test *)",
      "Bash(bun x *)",
      "Bash(bunx *)",
      "Bash(gh browse *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr list *)",
      "Bash(gh pr status)",
      "Bash(gh pr view *)",
      "Bash(gh repo view *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh search *)",
      "Bash(gh status)",
      "Bash(grep *)",
      "WebFetch",
      "WebSearch"
    ]
  },
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {},
  "skipDangerousModePermissionPrompt": true
}
