  },
  "React Context Provider": {
    "prefix": "rctx",
    "body": [
      "import { createContext, useContext, type ReactNode } from \"react\"",
      "",
      "type ${1:Name}ContextType = {",
      "  $2",
      "}",
      "",
      "const ${1}Context = createContext<${1}ContextType | null>(null)",
      "",
      "export function use${1}() {",
      "  const context = useContext(${1}Context)",
      "  if (!context) {",
      "    throw new Error(\"use${1} must be used within a ${1}Provider\")",
      "  }",
      "  return context",
      "}",
      "",
      "export function ${1}Provider({ children }: { children: ReactNode }) {",
      "  return (",
      "    <${1}Context.Provider value={{ $3 }}>",
      "      {children}",
      "    </${1}Context.Provider>",
      "  )",
      "}"
    ],
    "description": "React context with provider and hook"
  },
  "React Props Type": {
