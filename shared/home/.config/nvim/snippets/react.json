{
  "React Functional Component": {
    "prefix": "rfc",
    "body": [
      "export function ${1:Component}({ ${2:props} }: ${1}Props) {",
      "  return (",
      "    <div>",
      "      $0",
      "    </div>",
      "  )",
      "}"
    ],
    "description": "React functional component with props"
  },
  "React Functional Component Default Export": {
    "prefix": "rfce",
    "body": [
      "export default function ${1:Component}({ ${2:props} }: ${1}Props) {",
      "  return (",
      "    <div>",
      "      $0",
      "    </div>",
      "  )",
      "}"
    ],
    "description": "React functional component with default export"
  },
  "React Arrow Component": {
