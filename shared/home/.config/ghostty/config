# Ghostty theme
theme = Catppuccin Mocha

# Updates
auto-update-channel = tip

# Shell integrations
shell-integration = fish
quit-after-last-window-closed = true

# Font
font-family = GeistMono Nerd Font Mono
font-style = Regular
font-style-italic = Regular Italic
font-style-bold = Bold
font-style-bold-italic = Bold Italic
font-size = 14
adjust-cell-height = 16

# Opacity of split windows
unfocused-split-opacity = 0.75

background-opacity = 0.90
background-blur-radius = 50

# Cursor style
cursor-style-blink = true

# Clipboard settings
clipboard-read = allow
clipboard-write = allow

# macos options
macos-option-as-alt = right
macos-titlebar-proxy-icon = hidden

# Window settings
window-width = 90
window-height = 30
window-colorspace = display-p3
window-padding-color = background
window-padding-balance = true
window-padding-x = 16
window-padding-y = 16

# Decrease scroll sensitivity
mouse-scroll-multiplier = 0.5

# Split keybindings (vim-like, prefix: ctrl+;)
keybind = ctrl+semicolon>backslash=new_split:right
keybind = ctrl+semicolon>minus=new_split:down
keybind = ctrl+semicolon>h=goto_split:left
keybind = ctrl+semicolon>j=goto_split:bottom
keybind = ctrl+semicolon>k=goto_split:top
keybind = ctrl+semicolon>l=goto_split:right
keybind = ctrl+semicolon>shift+h=resize_split:left,40
keybind = ctrl+semicolon>shift+j=resize_split:down,40
keybind = ctrl+semicolon>shift+k=resize_split:up,40
keybind = ctrl+semicolon>shift+l=resize_split:right,40
keybind = ctrl+semicolon>z=toggle_split_zoom
keybind = ctrl+semicolon>equal=equalize_splits
keybind = ctrl+semicolon>x=close_surface
